{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "automerge": true,
  "platformAutomerge": true,
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "oxlint and oxlint-tsgolint must stay compatible, so update the oxc toolchain in one PR",
      "groupName": "oxc",
      "matchPackageNames": ["oxlint", "oxlint-tsgolint", "oxfmt"]
    },
    {
      "description": "Keep the Dockerfile oven/bun images in step with packageManager",
      "groupName": "bun",
      "matchPackageNames": ["bun", "oven/bun"]
    },
    {
      "description": "Client devDependencies get their own PRs: grouped with the other packages' fix(deps) updates, they would release the client",
      "matchFileNames": ["packages/client/package.json"],
      "matchDepTypes": ["devDependencies"],
      "additionalBranchPrefix": "client-",
      "semanticCommitType": "chore",
      "semanticCommitScope": "client-deps"
    }
  ]
}
