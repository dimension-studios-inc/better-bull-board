{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "baseBranchPatterns": ["develop"],
  "automerge": true,
  "platformAutomerge": true,
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "description": "Keep the Dockerfile oven/bun images in step with packageManager",
      "groupName": "bun",
      "matchPackageNames": ["bun", "oven/bun"]
    }
  ]
}
