{
  "name": "better-bull-board",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "bun run setup && oxlint && oxfmt --check",
    "format": "oxfmt",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "knip": "knip",
    "setup": "turbo run build --filter='@better-bull-board/*'^...",
    "build:app": "turbo run build --filter=@better-bull-board/app --env-mode=loose",
    "build:ingest": "turbo run build --filter=@better-bull-board/ingest --env-mode=loose",
    "prepare": "lefthook install",
    "doctor": "react-doctor --yes"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@shadcn/lint": "0.2.3",
    "@vercel/nft": "1.11.0",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-doctor": "0.9.18",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "msgpackr-extract"
  ]
}
