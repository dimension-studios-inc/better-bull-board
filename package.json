{
  "name": "better-bull-board",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check",
    "format": "biome format --write",
    "type-check": "turbo run type-check",
    "knip": "knip",
    "setup": "turbo run build --filter='@better-bull-board/*'^...",
    "build:app": "turbo run build --filter=@better-bull-board/app --env-mode=loose",
    "build:ingest": "turbo run build --filter=@better-bull-board/ingest --env-mode=loose",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "turbo": "2.10.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
