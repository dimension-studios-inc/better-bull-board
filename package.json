{
  "name": "better-bull-board",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "bun run setup && oxlint --type-aware && oxfmt --check",
    "format": "oxfmt",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "knip": "knip",
    "setup": "turbo run build --filter='@better-bull-board/*'^...",
    "build:app": "turbo run build --filter=@better-bull-board/app --env-mode=loose",
    "build:ingest": "turbo run build --filter=@better-bull-board/ingest --env-mode=loose",
    "release:client": "cd packages/client && semantic-release",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@vercel/nft": "1.11.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "semantic-release": "25.0.9",
    "semantic-release-monorepo": "8.0.2",
    "turbo": "2.11.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "msgpackr-extract"
  ]
}
