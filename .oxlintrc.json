{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "jsPlugins": ["@shadcn/lint"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    // Type-aware rules resolve workspace packages through their built dist/ types:
    // `bun run lint` and the pre-commit hook build them first (turbo-cached).
    "typeAware": true,
    "reportUnusedDisableDirectives": "error",
    "denyWarnings": true
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "settings": {
    "next": {
      "rootDir": "apps/app"
    }
  },
  "rules": {
    // Type-aware rules (typescript-eslint `recommended-type-checked` and `strict-type-checked` picks).
    "typescript/no-misused-promises": "error",
    "typescript/no-deprecated": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-find": "error",
    // `||` stays allowed on strings and booleans, where an empty string or `false` should fall through too.
    "typescript/prefer-nullish-coalescing": [
      "error",
      { "ignorePrimitives": { "string": true, "boolean": true }, "ignoreBooleanCoercion": true }
    ],
    "typescript/prefer-optional-chain": "error",
    "typescript/return-await": "error",
    "typescript/no-mixed-enums": "error",
    // Raw SQL rows and DOM/ref narrowing are cast on purpose; typescript-eslint keeps this rule out of its presets.
    "typescript/no-unsafe-type-assertion": "off",

    // TypeScript syntax rules.
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",

    // Core JavaScript rules.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-param-reassign": "error",
    "eslint/no-var": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-exponentiation-operator": "error",
    "eslint/prefer-object-spread": "error",
    "eslint/prefer-rest-params": "error",
    "eslint/prefer-spread": "error",
    "eslint/prefer-template": "error",
    "eslint/radix": "error",
    "eslint/no-useless-rename": "error",
    "eslint/no-useless-computed-key": "error",
    "eslint/no-template-curly-in-string": "error",
    // Streams, batches and reconciliations are processed sequentially on purpose.
    "eslint/no-await-in-loop": "off",
    // `_unused` parameters and `__dirname`/`__filename` shims are intentional.
    "eslint/no-underscore-dangle": "off",

    // Unicorn: modern built-ins and error hygiene.
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/error-message": "error",
    "unicorn/no-useless-switch-case": "error",
    // Colocated helpers (job runners, render helpers) read better next to their caller.
    "unicorn/consistent-function-scoping": "off",

    // Immutable updates in `map` are the idiomatic React/data pattern here.
    "oxc/no-map-spread": "off",

    // Modules.
    "import/no-cycle": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "import/no-mutable-exports": "error",

    // Promises.
    "promise/no-nesting": "error"
  },
  "overrides": [
    {
      "files": ["apps/app/**", "packages/ui/**"],
      "plugins": ["react", "nextjs", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        // The automatic JSX runtime doesn't need React in scope.
        "react/react-in-jsx-scope": "off",

        // @shadcn/lint: design-system rules, discovered from each package's components.json.
        "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
        // Also scans class strings kept in objects and helpers, outside className props.
        "shadcn/no-raw-colors": ["error", { "scanAllStrings": true }],
        "shadcn/no-arbitrary-values": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error",
        "shadcn/require-static-classes": "error"
      }
    },
    {
      // shadcn/ui components: owned code, but keep upstream's structure so `shadcn add --overwrite` diffs stay readable.
      "files": ["packages/ui/src/components/**"],
      "plugins": ["react", "jsx-a11y"],
      "rules": {
        "eslint/no-shadow": "off",
        "eslint/no-param-reassign": "off",
        "react/no-unstable-nested-components": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        // Components own their appearance and the structural values it needs (upstream @shadcn/lint guidance).
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ]
}
