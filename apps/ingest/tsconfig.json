{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@better-bull-board/typescript-config/react-library.json",
  "compilerOptions": {
    // bun runs src directly and ignores ${configDir} in the inherited paths.
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
