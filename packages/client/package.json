{
  "name": "@better-bull-board/client",
  "version": "0.0.0-semantic-release",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimension-studios-inc/better-bull-board.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "debug": "bun debug/index.ts",
    "prepublishOnly": "bun run build",
    "pack:check": "bun run build && bun pm pack --dry-run | grep -qE '^packed .+ dist/index\\.d\\.mts$'"
  },
  "dependencies": {
    "@rharkor/logger": "1.3.3",
    "@t3-oss/env-core": "0.13.11",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-bull-board/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "bullmq": "6.3.9",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "bullmq": "^6.0.0"
  }
}
