{
  "name": "@better-bull-board/bull-demo",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "debug": "dotenv -e .env -- tsx debug/index.ts",
    "stress:job-stream": "dotenv -e .env -- tsx debug/stress-job-stream.ts",
    "listen": "pnpm run build && dotenv -e .env -- node dist/worker.cjs"
  },
  "license": "ISC",
  "dependencies": {
    "@better-bull-board/client": "workspace:*",
    "@better-bull-board/db": "workspace:*",
    "@better-bull-board/typescript-config": "workspace:*",
    "@rharkor/logger": "1.3.3",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "6.2.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "25.9.5",
    "dotenv-cli": "11.0.0",
    "tsx": "4.23.12"
  }
}
