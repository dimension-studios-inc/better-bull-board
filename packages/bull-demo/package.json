{
  "name": "@better-bull-board/bull-demo",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "debug": "bun debug/index.ts",
    "stress:job-stream": "bun debug/stress-job-stream.ts",
    "listen": "bun run build && node --env-file-if-exists=.env dist/worker.cjs"
  },
  "dependencies": {
    "@better-bull-board/client": "workspace:*",
    "@better-bull-board/db": "workspace:*",
    "@rharkor/logger": "1.3.3",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "6.3.9",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-bull-board/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
