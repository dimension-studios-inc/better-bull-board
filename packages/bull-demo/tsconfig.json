{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@better-bull-board/typescript-config/react-library.json",
  "compilerOptions": {
    // debug/ sits next to src/, so the project root is the source root.
    "rootDir": "${configDir}"
  },
  "include": ["src/**/*.ts", "debug/**/*.ts"]
}
