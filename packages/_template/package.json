{
  "name": "@better-bull-board/template",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "debug": "bun debug/index.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@rharkor/logger": "1.3.3",
    "@t3-oss/env-core": "0.13.11",
    "dotenv": "18.0.4",
    "zod": "4.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "devDependencies": {
    "@better-bull-board/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
