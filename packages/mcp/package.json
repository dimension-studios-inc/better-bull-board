{
  "name": "@better-bull-board/mcp",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "better-bull-board-mcp": "dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "npx -y dotenv-cli -e .env -- tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "type-check": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@better-bull-board/client": "*",
    "@better-bull-board/core": "*",
    "@better-bull-board/typescript-config": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "6.2.0",
    "dotenv": "17.4.2",
    "ioredis": "6.0.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "zod": "4.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./scopes": {
      "types": "./dist/scopes.d.mts",
      "import": "./dist/scopes.mjs"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "25.9.5",
    "tsx": "4.23.12"
  }
}
