{
  "name": "@better-bull-board/mcp",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "bin": {
    "better-bull-board-mcp": "dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.mjs",
    "type-check": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@better-bull-board/client": "workspace:*",
    "@better-bull-board/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "6.3.8",
    "dotenv": "18.0.4",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./scopes": {
      "types": "./dist/scopes.d.mts",
      "import": "./dist/scopes.mjs"
    }
  },
  "type": "module",
  "devDependencies": {
    "@better-bull-board/typescript-config": "workspace:*",
    "@types/node": "25.9.8",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
